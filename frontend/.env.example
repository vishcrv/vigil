# 127.0.0.1, not localhost: uvicorn binds IPv4 by default, but browsers on Windows resolve
# "localhost" to IPv6 ::1 first and the request is refused before it ever reaches the server.
# Symptom if you get this wrong: "Can't reach the backend" in the UI while curl works fine.
VITE_API_BASE_URL=http://127.0.0.1:8000
