# IMPORTANT: create this at https://aistudio.google.com/apikey - NOT in the Google Cloud
# Console. A Cloud-Console-issued key lands in a project with a zero free-tier quota grant and
# fails every call with 429 RESOURCE_EXHAUSTED no matter which APIs you enable on it.
GOOGLE_API_KEY=

# Data paths
DATA_DIR=./data          # optional, defaults to ./data if unset; path to enriched Parquet files
SQLITE_PATH=./aml_agent.db   # optional, defaults to ./aml_agent.db if unset

# Kaggle: not needed at runtime, dataset fetch is a documented manual download step in README
# (see spec.md Decisions Log item 6), not a scripted/credentialed part of the app itself.
